# Used only when you run the backend on your laptop with ./mvnw spring-boot:run
# Copy to .env  (cp .env.example .env). .env is never committed.
# Passwords must match swiftdrop-deploy/.env, because the database and RabbitMQ run from there.
# Do not put comments at the end of a value line.

# ---------- Database ----------
DB_URL=jdbc:postgresql://localhost:5432/swiftdrop
DB_USER=swiftdrop
# same value as POSTGRES_PASSWORD in swiftdrop-deploy/.env
DB_PASSWORD=change-me

# ---------- RabbitMQ ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=swiftdrop
# same value as RABBITMQ_PASSWORD in swiftdrop-deploy/.env
RABBITMQ_PASSWORD=change-me

# ---------- Email (Mailpit fake inbox) ----------
MAIL_HOST=localhost
MAIL_PORT=1025

# ---------- Security ----------
# same value as JWT_SECRET in swiftdrop-deploy/.env
# at least 32 characters, e.g. the output of: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
JWT_REMEMBER_ME_DAYS=7
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# ---------- Seed accounts ----------
ADMIN_EMAIL=admin@swiftdrop.lk
ADMIN_PASSWORD=change-me-123
SEED_DEMO_USERS=true
DEMO_PASSWORD=Demo12345

# ---------- Google login ("Continue with Google") ----------
# Leave both empty to turn it off (the app still starts; /oauth2/** returns 404).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type "Web application"),
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
