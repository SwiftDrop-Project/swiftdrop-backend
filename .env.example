# Used only when you run the backend on your laptop with ./mvnw spring-boot:run
# Copy to .env  (cp .env.example .env). .env is never committed.
# Tests never read these database settings (they use Testcontainers).
# Do not put comments at the end of a value line.

# ---------- Database ----------
# The team's shared Neon database (get the values from the Neon console > Connect, "Java" / JDBC):
#   DB_URL=jdbc:postgresql://<neon-host>/swiftdrop?sslmode=require
# Use the DIRECT host (ep-xxx.<region>.aws.neon.tech), not the "-pooler" one: Flyway needs a session connection.
# DB_USER / DB_PASSWORD are the Neon role and its password.
# Or a local database from swiftdrop-deploy (DB_PASSWORD = POSTGRES_PASSWORD in swiftdrop-deploy/.env):
#   DB_URL=jdbc:postgresql://localhost:5432/swiftdrop
DB_URL=jdbc:postgresql://<neon-host>/swiftdrop?sslmode=require
DB_USER=swiftdrop
DB_PASSWORD=change-me

# ---------- RabbitMQ (from swiftdrop-deploy) ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=swiftdrop
# same value as RABBITMQ_PASSWORD in swiftdrop-deploy/.env
RABBITMQ_PASSWORD=change-me

# ---------- Email (verification and password reset codes) ----------
# Default: Mailpit fake inbox from swiftdrop-deploy (no auth). Open http://localhost:8025 to read the emails.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
# A plain address, or a name plus the address in angle brackets: SwiftDrop <team@gmail.com>
MAIL_FROM=no-reply@swiftdrop.lk
# WARNING: true prints the whole SMTP conversation to the console, including your username and
# password (base64-encoded, which is NOT encryption). Keep it false; turn it on only briefly to
# troubleshoot on your own machine, and never paste or share that output.
MAIL_DEBUG=false
# Real emails through Gmail (free, about 500 emails/day). The Gmail account needs 2-Step Verification; create an
# App Password at https://myaccount.google.com/apppasswords and use it (16 characters, no spaces) as MAIL_PASSWORD:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=yourteam@gmail.com
#   MAIL_PASSWORD=abcdabcdabcdabcd
#   MAIL_SMTP_AUTH=true
#   MAIL_STARTTLS=true
#   MAIL_FROM=SwiftDrop <yourteam@gmail.com>
# Sign-up rejects email domains without MX records (DNS lookup). Set to false to skip the lookup (e.g. offline).
EMAIL_MX_CHECK=true

# ---------- Security ----------
# same value as JWT_SECRET in swiftdrop-deploy/.env
# at least 32 characters, e.g. the output of: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
JWT_REMEMBER_ME_DAYS=7
# HMAC key for the stored 6-digit email codes. Optional: empty = derived from JWT_SECRET.
# If set: at least 32 characters (openssl rand -base64 48).
VERIFICATION_CODE_SECRET=
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# ---------- Seed accounts ----------
ADMIN_EMAIL=admin@swiftdrop.lk
ADMIN_PASSWORD=change-me-123
SEED_DEMO_USERS=true
DEMO_PASSWORD=Demo12345

# ---------- Courier demo (TEMPORARY - delete when WP3 / WP8 implement DeliveryApi / AssignmentApi) ----------
# true: the courier endpoints use in-memory parcels (FAKE_DELIVERY) and courier tasks (FAKE_DISPATCH). With both on
# (and SEED_DEMO_USERS=true), courier@swiftdrop.lk gets the Delgoda -> Gampaha -> Matara -> Deniyaya demo: one
# PICKUP, one TRANSFER and one DELIVERY task. Nothing is saved; a restart resets them. Leave false on shared servers.
SWIFTDROP_FAKE_DELIVERY=false
SWIFTDROP_FAKE_DISPATCH=false

# ---------- Google login ("Continue with Google") ----------
# Leave both empty to turn it off (the app still starts; /oauth2/** returns 404).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type "Web application"),
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
